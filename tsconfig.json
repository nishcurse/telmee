{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "paths": {
      "~*": [
        "./*", 
      ],
      "@app-types/*": ["./types/*"],
      "@/lib/*": ["./lib/*"],
      "@constants/*": ["./constants/*"],
      "@store/*" : ["./store/*"]
    },
    "baseUrl": ".",
  },
}
